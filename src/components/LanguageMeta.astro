---
import LanguageDot from "@/components/LanguageDot.astro";
import MetaItem from "@/components/MetaItem.astro";
import type { Language } from "@/modules/github";

type Props = {
	/** Null for a repo GitHub could not classify — the meta item is dropped */
	language: Language | null;
};

const { language } = Astro.props;
---

{language && (
	<MetaItem>
		<LanguageDot color={language.color} />
		{language.name}
	</MetaItem>
)}
