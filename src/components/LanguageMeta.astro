---
import LanguageDot from "@/components/LanguageDot.astro";
import MetaItem from "@/components/MetaItem.astro";
import { languageColor } from "@/modules/github";

type Props = {
	/** Null for a repo GitHub could not classify — the meta item is dropped */
	language: string | null;
};

const { language } = Astro.props;
---

{
	language && (
		<MetaItem>
			<LanguageDot color={languageColor(language)} />
			{language}
		</MetaItem>
	)
}
