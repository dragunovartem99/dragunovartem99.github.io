---
import Counter from "@/components/Counter.astro";
import LanguageMeta from "@/components/LanguageMeta.astro";
import MetaItem from "@/components/MetaItem.astro";
import Octicon from "@/components/Octicon.astro";
import type { RepoView } from "@/modules/github";

type Props = {
	repo: RepoView;
};

const { repo } = Astro.props;
---

<li class="repo">
	<h3 class="repo-name">
		<a href={repo.url}>{repo.name}</a>
	</h3>

	<p class="repo-description">{repo.description}</p>

	<div class="repo-meta">
		<LanguageMeta language={repo.language} />
		<Counter
			icon="star"
			count={repo.stars}
			label="stars"
		/>
		<Counter
			icon="repoForked"
			count={repo.forks}
			label="forks"
		/>
		{
			repo.license && (
				<MetaItem>
					<Octicon name="law" />
					{repo.license}
				</MetaItem>
			)
		}
		<MetaItem>Updated {repo.updated}</MetaItem>
	</div>
</li>

<style>
	.repo {
		padding: 16px 0;
		border-bottom: 1px solid var(--border-muted);
	}

	.repo:first-child {
		padding-top: 0;
	}

	.repo-name {
		margin: 0;
		font-size: 16px;
		font-weight: 600;
		line-height: 1.25;
	}

	.repo-description {
		max-width: 75ch;
		margin: 4px 0 8px;
		color: var(--fg-muted);
	}

	.repo-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		color: var(--fg-muted);
		font-size: 12px;
	}
</style>
