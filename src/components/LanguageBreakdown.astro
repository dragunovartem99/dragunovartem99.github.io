---
import type { LanguageSlice } from "@/modules/github";

type Props = {
	/** Every language across the public repos, biggest share first */
	slices: LanguageSlice[];
};

const { slices } = Astro.props;

const share = (slice: LanguageSlice) => `${slice.percent.toFixed(1)}%`;
---

{
	slices.length > 0 && (
		<div class="languages">
			<h2 class="title">Languages</h2>

			<div class="bar">
				{slices.map((slice) => (
					<span
						class="slice"
						style={{
							width: `${slice.percent.toFixed(2)}%`,
							backgroundColor: slice.color,
						}}
						title={`${slice.language} ${share(slice)}`}
					/>
				))}
			</div>

			<ul class="legend">
				{slices.map((slice) => (
					<li class="item">
						<span
							class="dot"
							style={{ backgroundColor: slice.color }}
						/>
						{slice.language} <span class="share">{share(slice)}</span>
					</li>
				))}
			</ul>
		</div>
	)
}

<style>
	.languages {
		margin-top: 24px;
	}

	.title {
		margin: 0 0 8px;
		color: var(--fg-muted);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.bar {
		display: flex;
		height: 8px;
		overflow: hidden;
		border-radius: 6px;
		background-color: var(--canvas-subtle);
	}

	.slice {
		height: 100%;
	}

	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 16px;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
		font-size: 12px;
	}

	.item {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	/* The same dot as a repo's language, small enough to sit in a legend line */
	.dot {
		display: inline-block;
		width: 12px;
		height: 12px;
		border: 1px solid var(--border-muted);
		border-radius: 50%;
		flex-shrink: 0;
	}

	.share {
		color: var(--fg-muted);
		font-variant-numeric: tabular-nums;
	}
</style>
