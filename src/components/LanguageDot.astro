---
type Props = {
	/** Linguist's color for the language, already resolved */
	color: string;
};

const { color } = Astro.props;
---

<span
	class="dot"
	style={{ backgroundColor: color }}
></span>

<style>
	.dot {
		display: inline-block;
		width: 12px;
		height: 12px;
		border: 1px solid var(--border-muted);
		border-radius: 50%;
		flex-shrink: 0;
	}
</style>
