---
import Card from "@/components/Card.astro";
import Counter from "@/components/Counter.astro";
import LanguageMeta from "@/components/LanguageMeta.astro";
import MetaItem from "@/components/MetaItem.astro";
import Octicon from "@/components/Octicon.astro";
import type { RepoView } from "@/modules/github";

type Props = {
	repo: RepoView;
};

// A repo with something to show points at the thing itself and keeps a link to
// the code — otherwise the card is the repo already
const { repo } = Astro.props;
---

<Card title={repo.name} href={repo.site ?? repo.url}>
	{repo.description}

	<Fragment slot="meta">
		<LanguageMeta language={repo.language} />
		<Counter icon="star" count={repo.stars} label="stars" />
		<Counter icon="repoForked" count={repo.forks} label="forks" />
		{repo.site && (
			<MetaItem>
				<a class="source" href={repo.url}>
					<Octicon name="mark" />
					Source
				</a>
			</MetaItem>
		)}
	</Fragment>
</Card>

<style>
	/* Quiet enough to sit among the counters, until it is pointed at. Only the
	   anchor itself rises above the card-wide link, so the gaps around it still
	   belong to the card. */
	.source {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: inherit;
	}

	.source:hover {
		color: var(--accent-fg);
	}
</style>
