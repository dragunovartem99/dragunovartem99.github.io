---
import { REPO_URL } from "@/constants";

type Props = {
	/** The build time — what "built on" actually means here */
	now: Date;
};

const { now } = Astro.props;

const stamp = now.toISOString();
---

<footer class="footer">
	Built from the GitHub API on <time datetime={stamp}>{stamp.slice(0, 10)}</time> ·
	<a href={REPO_URL}>source</a>
</footer>

<style>
	.footer {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 40px 32px;
		color: var(--fg-muted);
		font-size: 12px;
		text-align: center;
	}
</style>
