---
import Octicon from "@/components/Octicon.astro";
import ProfileSidebar from "@/components/ProfileSidebar.astro";
import RepoCard from "@/components/RepoCard.astro";
import RepoRow from "@/components/RepoRow.astro";
import { HIDDEN_REPOS, USERNAME } from "@/constants.ts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
	fetchLanguageBytes,
	fetchPinned,
	fetchRepos,
	fetchUser,
	isShowable,
	languageBreakdown,
	mapProfile,
	mapRepo,
} from "@/modules/github";

// The whole page is one build-time read of the GitHub API — nothing here runs
// in the browser, and the HTML is as fresh as the last deploy.
const [user, owned, pinned] = await Promise.all([
	fetchUser({ username: USERNAME }),
	fetchRepos({ username: USERNAME }),
	fetchPinned({ username: USERNAME }),
]);

// What the API returns is every repo; what this page prints is the page's call
const repos = owned.filter((repo) => isShowable({ repo, hidden: HIDDEN_REPOS }));

const bytes = await fetchLanguageBytes({ username: USERNAME, repos });

const now = new Date();

const profile = mapProfile({ user });

const byName = new Map(repos.map((repo) => [repo.name, repo]));

// The featured cards are the profile pins, in the profile's order. A pin the
// page would not show anyway — hidden, archived, undescribed — drops out
// rather than rendering an empty card.
const featured = pinned.flatMap((name) => {
	const repo = byName.get(name);

	return repo ? [mapRepo({ repo, now })] : [];
});

const featuredNames = new Set(featured.map((repo) => repo.name));

const rest = repos
	.filter((repo) => !featuredNames.has(repo.name))
	.map((repo) => mapRepo({ repo, now }));
---

<BaseLayout
	title={`${profile.name} · GitHub`}
	description={profile.bio ?? `Public work of @${profile.login}`}
	profile={profile}
	now={now}
>
	<ProfileSidebar profile={profile} slices={languageBreakdown({ bytes })} />

	<div class="content">
		{featured.length > 0 && (
			<section id="featured">
				<h2 class="section-title">
					<span class="section-icon">
						<Octicon name="pin" />
					</span>
					Featured
				</h2>

				<ul class="card-grid">
					{featured.map((repo) => (
						<RepoCard repo={repo} />
					))}
				</ul>
			</section>
		)}

		{rest.length > 0 && (
			<section id="repositories">
				<h2 class="section-title">
					<span class="section-icon">
						<Octicon name="book" />
					</span>
					Other repositories
					<span class="counter">{rest.length}</span>
				</h2>

				<ul class="repo-list">
					{rest.map((repo) => (
						<RepoRow repo={repo} />
					))}
				</ul>
			</section>
		)}
	</div>
</BaseLayout>

<style>
	.content {
		display: flex;
		flex-direction: column;
		gap: 40px;
		min-width: 0;
	}

	.section-title {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 16px;
		padding-bottom: 8px;
		border-bottom: 1px solid var(--border-muted);
		font-size: 16px;
		font-weight: 600;
	}

	/* The leading octicon is furniture, so it stays quieter than the heading */
	.section-icon {
		display: flex;
		color: var(--fg-muted);
	}

	.counter {
		padding: 0 6px;
		background-color: var(--canvas-subtle);
		border: 1px solid var(--border-muted);
		border-radius: 2em;
		color: var(--fg-muted);
		font-size: 12px;
		font-weight: 500;
		line-height: 18px;
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.repo-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 768px) {
		.card-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
