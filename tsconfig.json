{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "src/**/*", "astro.config.ts"],
	"exclude": ["dist"],
	"compilerOptions": {
		"types": ["node"],
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
